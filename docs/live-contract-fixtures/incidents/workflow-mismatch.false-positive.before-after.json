{
  "fixture_id": "workflow-mismatch-false-positive-before-after",
  "fixture_type": "workflow-mismatch-case",
  "version": "v1",
  "summary": "固化 workflow_mismatch 的两类误伤与两类正例：system/audit 评论应忽略，普通 current context 实现说明不应触发 context_gap，但真实 context gap / external blocked 仍应命中。",
  "source_refs": [
    "api/workflow-mismatch.test.js",
